# ==============================================================================
# DevHandoff — Environment Configuration (IBM watsonx.ai)
# ==============================================================================
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env      (Linux/macOS)
#    copy .env.example .env    (Windows)
# 2. Fill in your IBM Cloud credentials below.
# 3. Never commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IBM Cloud API Key (Required for AI synthesis)
# ------------------------------------------------------------------------------
# How to get it:
# 1. Log in to IBM Cloud: https://cloud.ibm.com
# 2. Go to: Manage > Access (IAM) > API keys (https://cloud.ibm.com/iam/apikeys)
# 3. Click "Create an IBM Cloud API key", give it a name, and copy the key.
WATSONX_API_KEY=your_ibm_cloud_api_key_here
# (Aliases also recognized: IBM_API_KEY, IBM_CLOUD_API_KEY)

# ------------------------------------------------------------------------------
# 2. IBM watsonx.ai Project ID (Required for AI synthesis)
# ------------------------------------------------------------------------------
# How to get it:
# 1. Log in to watsonx.ai: https://dataplatform.cloud.ibm.com/wx/home
# 2. Open your project (or click "New project" to create one).
# 3. In your project, go to the "Manage" tab > "General".
# 4. Copy the "Project ID" (it is a UUID, e.g. 1a2b3c4d-5e6f-...).
WATSONX_PROJECT_ID=your_watsonx_project_id_uuid_here
# (Aliases also recognized: IBM_PROJECT_ID)

# ------------------------------------------------------------------------------
# 3. IBM watsonx.ai Service URL (Optional, defaults to Dallas us-south)
# ------------------------------------------------------------------------------
# Match this to your watsonx.ai instance region:
# - Dallas (US South): https://us-south.ml.cloud.ibm.com
# - Frankfurt (EU DE): https://eu-de.ml.cloud.ibm.com
# - London (EU GB):    https://eu-gb.ml.cloud.ibm.com
# - Tokyo (JP TOK):    https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ------------------------------------------------------------------------------
# 4. Foundation Model ID (Optional, defaults to ibm/granite-3-8b-instruct)
# ------------------------------------------------------------------------------
# Available IBM Granite and open models on watsonx.ai include:
# - ibm/granite-3-8b-instruct     (Fast, high quality, recommended)
# - ibm/granite-13b-chat-v2
# - ibm/granite-20b-code-instruct (Specialized for code analysis)
# - meta-llama/llama-3-3-70b-instruct
# - meta-llama/llama-3-1-8b-instruct
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ------------------------------------------------------------------------------
# 5. GitHub Personal Access Token (Optional)
# ------------------------------------------------------------------------------
# Used by Subagent 1 to fetch linked issues / PRs from GitHub for the repository.
# If left blank, DevHandoff works normally with a graceful local fallback.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 6. DevHandoff API Key Protection (Optional)
# ------------------------------------------------------------------------------
# Protect the backend API with an X-API-Key header.
# If unset, backend runs in open development mode without requiring authentication.
DEVHANDOFF_API_KEY=
